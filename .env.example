# Copier vers .env.local et remplir (ne pas committer .env.local).
# Vercel : mêmes clés dans Project → Settings → Environment Variables.

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement (jamais NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=

# Persistance événements QC / Copilot → table `qc_events` (route /api/qc-events). Désactiver : 0
# NEXT_PUBLIC_QC_EVENTS_PERSIST=0

# Analyse terrain unifiée POST /api/analyze (Gemini vision + structuration OpenRouter).
# GEMINI_API_KEY=
# Optionnel : modèle vision (`lib/services/gemini.ts`). Défaut : gemini-2.5-flash
# GEMINI_VISION_MODEL=gemini-2.5-flash
# OPENROUTER_API_KEY=
# En dev (`NODE_ENV=development`), OpenRouter est off par défaut (parse Gemini local).
# ENABLE_OPENROUTER=true  — forcer OpenRouter en dev
# ENABLE_OPENROUTER=false — forcer off en prod
# Optionnel : modèle structuration JSON (`lib/services/openrouter.ts`). Défaut : openai/gpt-4o-mini
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Optionnel : `npm run test:all` si le dev tourne sur un autre port
# TEST_BASE_URL=http://localhost:3001
# Modèle pour `npm run test:all` test 4 (sinon = GEMINI_VISION_MODEL ou gemini-2.5-flash)
# TEST_GEMINI_MODEL=gemini-2.0-flash

# Clé OpenAI côté serveur : photos, extraction couverture (DV image/PDF, description), assist, etc.
# Sans elle, POST /api/cover-dv-extract et autres routes IA répondent 503.
# Analyse vision des photos d'inspection (/api/upload-photo → photos.analysis, PDF reports-pdf).
OPENAI_API_KEY=
# Optionnel : ID organisation OpenAI (dashboard → Organization settings) si la clé projet exige ce header (sinon 401 sur /v1/responses).
# OPENAI_ORGANIZATION=org_...
# Optionnel (défaut gpt-4o-mini)
# REPORTS_AI_MODEL=gpt-4o-mini
# Classification défauts (POST /api/classify-defects + pipeline après polish) — défaut = REPORTS_AI_MODEL ou gpt-4o-mini
# CLASSIFY_DEFECTS_MODEL=gpt-4o-mini

# API trigger-inspection (header x-trigger-secret)
TRIGGER_INSPECTION_SECRET=

# Phase 9C — identité inspecteur dev (Steve) sans login Supabase (dev uniquement).
# DEV_AUTH_BYPASS=true
# NEXT_PUBLIC_DEV_AUTH_BYPASS=true
# UUID Supabase pour écritures DB en dev (sinon résolution auto)
# DEV_INSPECTOR_USER_ID=

# Optionnel : déverrouillage des rapports verrouillés (report-content / report-cover).
# Par défaut autorisé en local (NODE_ENV=development, localhost, ou hors Vercel : VERCEL absent).
# Sur Vercel en prod, utiliser INSPECTFLOW_DEV_UNLOCK_REPORT=1 pour regénérer un rapport verrouillé.
# Serveur prod non-Vercel : INSPECTFLOW_DEV_UNLOCK_REPORT=0 pour imposer le verrou en base.
# INSPECTFLOW_DEV_UNLOCK_REPORT=1
# INSPECTFLOW_DEV_UNLOCK_REPORT=0

# Désactive la garde « readiness = ready » avant ensure HTML / PDF (secours uniquement).
# ALLOW_PDF_EXPORT_WITHOUT_READINESS=1

# Prévisualisation PDF locale (Puppeteer) — route POST /api/dev/pdf-puppeteer uniquement en dev
# N’altère pas le pipeline Edge reports-pdf.
# ENABLE_PUPPETEER_PDF=1
# + npm install puppeteer --save-dev

# Edge Function PDF (slug par défaut : reports-pdf)
# REPORTS_PDF_SLUG=reports-pdf

# Edge create-report (slug par défaut : create-report)
# CREATE_REPORT_SLUG=create-report

# Test bout-en-bout (npm run smoke:e2e — lit .env.local sans --env-file Node)
# Local : aligner sur le port affiché par `npm run dev` (ex. 3001 si 3000 est pris)
# Vercel : SMOKE_BASE_URL=https://votre-projet.vercel.app
# SMOKE_BASE_URL=http://localhost:3000
# SMOKE_USER_ID=
# SMOKE_INSPECTION_ID=
# SMOKE_SKIP_TRIGGER=1
# SMOKE_SKIP_REPORT_COVER=1

# Batch photos test-data/inspection-demo (npm run test:inspection-demo)
# DEMO_REPORT_ID=
# DEMO_CREATE_REPORT=1
# DEMO_UPLOAD_LIMIT=10
# DEMO_UPLOAD_DELAY_MS=400

# Dashboard /middleware Basic Auth
# DASHBOARD_USER=
# DASHBOARD_PASS=

# Première vue rapport (optionnel)
# RESEND_API_KEY=
# RESEND_FROM=
# WEBHOOK_REPORT_OPENED=
# WEBHOOK_SECRET=
