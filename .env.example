# Copier vers .env.local et remplir (ne pas committer .env.local).
# Vercel : mêmes clés dans Project → Settings → Environment Variables.

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement (jamais NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=

# API trigger-inspection (header x-trigger-secret)
TRIGGER_INSPECTION_SECRET=

# Edge Function PDF (slug par défaut : reports-pdf)
# REPORTS_PDF_SLUG=reports-pdf

# Dashboard /middleware Basic Auth
# DASHBOARD_USER=
# DASHBOARD_PASS=

# Première vue rapport (optionnel)
# RESEND_API_KEY=
# RESEND_FROM=
# WEBHOOK_REPORT_OPENED=
# WEBHOOK_SECRET=
