# Copier vers .env.local et remplir (ne pas committer .env.local).
# Vercel : mêmes clés dans Project → Settings → Environment Variables.

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement (jamais NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=

# Persistance événements QC / Copilot → table `qc_events` (route /api/qc-events). Désactiver : 0
# NEXT_PUBLIC_QC_EVENTS_PERSIST=0

# Analyse vision des photos d'inspection (route /api/upload-photo → colonne photos.analysis, PDF reports-pdf)
OPENAI_API_KEY=
# Optionnel (défaut gpt-4o-mini)
# REPORTS_AI_MODEL=gpt-4o-mini
# Classification défauts (POST /api/classify-defects + pipeline après polish) — défaut = REPORTS_AI_MODEL ou gpt-4o-mini
# CLASSIFY_DEFECTS_MODEL=gpt-4o-mini

# API trigger-inspection (header x-trigger-secret)
TRIGGER_INSPECTION_SECRET=

# Optionnel : déverrouillage des rapports verrouillés (report-content / report-cover).
# Par défaut autorisé en local (NODE_ENV=development, localhost, ou hors Vercel : VERCEL absent).
# Sur Vercel en prod, utiliser INSPECTFLOW_DEV_UNLOCK_REPORT=1 pour regénérer un rapport verrouillé.
# Serveur prod non-Vercel : INSPECTFLOW_DEV_UNLOCK_REPORT=0 pour imposer le verrou en base.
# INSPECTFLOW_DEV_UNLOCK_REPORT=1
# INSPECTFLOW_DEV_UNLOCK_REPORT=0

# Désactive la garde « readiness = ready » avant ensure HTML / PDF (secours uniquement).
# ALLOW_PDF_EXPORT_WITHOUT_READINESS=1

# Prévisualisation PDF locale (Puppeteer) — route POST /api/dev/pdf-puppeteer uniquement en dev
# N’altère pas le pipeline Edge reports-pdf.
# ENABLE_PUPPETEER_PDF=1
# + npm install puppeteer --save-dev

# Edge Function PDF (slug par défaut : reports-pdf)
# REPORTS_PDF_SLUG=reports-pdf

# Edge create-report (slug par défaut : create-report)
# CREATE_REPORT_SLUG=create-report

# Test bout-en-bout (npm run smoke:e2e — lit .env.local sans --env-file Node)
# Aligner sur le port affiché par `npm run dev` (ex. 3001 si 3000 est pris)
# SMOKE_BASE_URL=http://localhost:3000
# SMOKE_USER_ID=
# SMOKE_INSPECTION_ID=
# SMOKE_SKIP_TRIGGER=1

# Dashboard /middleware Basic Auth
# DASHBOARD_USER=
# DASHBOARD_PASS=

# Première vue rapport (optionnel)
# RESEND_API_KEY=
# RESEND_FROM=
# WEBHOOK_REPORT_OPENED=
# WEBHOOK_SECRET=
