{
  "name": "inspectflow-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:3001": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "upload:report-pdf": "node --env-file=.env.local scripts/upload-report-pdf.cjs",
    "supabase:deploy:reports-pdf": "npx supabase functions deploy reports-pdf",
    "supabase:deploy:create-report": "npx supabase functions deploy create-report",
    "supabase:deploy:upload-photo": "npx supabase functions deploy upload-photo",
    "supabase:db:push": "npx supabase db push",
